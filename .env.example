# Public URL used for secure cookies and links.
APP_URL=https://sys.example.com
PORT=3000
NODE_ENV=production
NPM_REGISTRY=https://registry.npmjs.org/
GOPROXY=https://proxy.golang.org,direct

# Generate with: openssl rand -hex 32
APP_ENCRYPTION_KEY=replace-with-64-hex-characters

# Used only when the database has no users. Change it after first login.
ADMIN_INITIAL_USERNAME=root
ADMIN_INITIAL_PASSWORD=replace-on-first-login

# A random token used by Prometheus to scrape the private metrics endpoint.
METRICS_TOKEN=replace-with-a-long-random-token

# Optional SMTP defaults. They can also be configured from the admin UI.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_RECIPIENTS=

# Optional self-hosted ntfy integration. Tokens are mounted as Compose secrets.
NTFY_BASE_URL=https://notify.example.com
NTFY_PROVISIONER_URL=http://host.docker.internal:6601
